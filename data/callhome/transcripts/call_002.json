  {
    "source_file": "call_002.wav",
    "speaker_id": "B",
    "start_time": 281.5,
    "end_time": 283.5,
    "text": "I mean, she's home now all day without anything."
  },
  {
    "source_file": "call_002.wav",
    "speaker_id": "B",
    "start_time": 283.5,
    "end_time": 285.5,
    "text": "The kids have gone from nine to four."
